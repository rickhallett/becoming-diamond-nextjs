# Axiom Logging Configuration
AXIOM_TOKEN=xaat-your-token-here
AXIOM_DATASET=becoming-diamond-prod
# AXIOM_ORG_ID=your-org-id  # Optional

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=your-nextauth-secret-here

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional GitHub OAuth (for CMS)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database (Turso)
TURSO_DATABASE_URL=libsql://your-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Gmail SMTP
GMAIL_USER=support@becomingdiamond.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Bunny Stream Video
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_API_KEY=your-api-key
BUNNY_STREAM_CDN_HOSTNAME=your-cdn-hostname

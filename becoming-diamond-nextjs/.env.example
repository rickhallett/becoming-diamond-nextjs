# ============================================
# BECOMING DIAMOND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local for development
# For production, use .env.prod or Vercel dashboard
# Last updated: 2025-11-15

# ============================================
# NEXTAUTH.JS v5 - AUTHENTICATION
# ============================================
# Development: http://localhost:3003
# Production: https://www.becomingdiamond.com
NEXTAUTH_URL=http://localhost:3003
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (Member Authentication)
# Setup: https://console.cloud.google.com/apis/credentials
# Development Redirect: http://localhost:3003/api/auth/callback/google
# Production Redirect: https://www.becomingdiamond.com/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your-google-oauth-secret

# GitHub OAuth (Member Authentication - OPTIONAL)
# Setup: https://github.com/settings/developers
# Development Redirect: http://localhost:3003/api/auth/callback/github
# Production Redirect: https://www.becomingdiamond.com/api/auth/callback/github
# AUTH_GITHUB_ID=your-github-oauth-app-id
# AUTH_GITHUB_SECRET=your-github-oauth-secret

# Resend (Email Magic Links - PRODUCTION ONLY)
# Setup: https://resend.com/
# AUTH_RESEND_KEY=re_your-resend-api-key

# Legacy (for compatibility)
AUTH_URL=http://localhost:3003

# ============================================
# DECAP CMS - CONTENT MANAGEMENT
# ============================================
# Separate GitHub OAuth App (NOT the same as AUTH_GITHUB_ID)
# Setup: https://github.com/settings/developers
# Development OAuth App: becoming-diamond-decap-dev
# Production OAuth App: becoming-diamond-decap-prod
# Development Redirect: http://localhost:3003/api/callback
# Production Redirect: https://www.becomingdiamond.com/api/callback
GITHUB_CLIENT_ID=your-github-decap-cms-client-id
GITHUB_CLIENT_SECRET=your-github-decap-cms-secret

# GitHub Personal Access Token (for Decap CMS operations - OPTIONAL)
GITHUB_TOKEN=

# ============================================
# DATABASE - TURSO (SQLITE)
# ============================================
# Setup: https://turso.tech/
# Create database: turso db create becoming-diamond-[env]
# Get URL: turso db show becoming-diamond-[env]
# Get token: turso db tokens create becoming-diamond-[env]
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Legacy Database Aliases (same values as above)
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# ============================================
# PAYMENTS - STRIPE
# ============================================
# Development: Test Mode Keys
# Production: Live Mode Keys
# Setup: https://dashboard.stripe.com/apikeys
# WARNING: Use TEST keys for development, LIVE keys for production

# Public Keys (exposed to client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Secret Keys (server-side only)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Webhook Secrets
# Development: Generate with `stripe listen --forward-to localhost:3003/api/stripe/webhook`
# Production: Get from Stripe dashboard webhook settings
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_your-webhook-signing-secret

# Price IDs (Generated in Stripe Dashboard)
# Development: Test Mode Price IDs
# Production: Live Mode Price IDs
STRIPE_PRICE_DIAMOND_SPRINT_TEST=price_your-sprint-price-id
STRIPE_PRICE_MONTHLY_TEST=price_your-monthly-price-id
STRIPE_PRICE_ANNUAL_TEST=price_your-annual-price-id

# Public Price IDs (exposed to client)
NEXT_PUBLIC_STRIPE_PRICE_DIAMOND_SPRINT_TEST=price_your-sprint-price-id
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_TEST=price_your-monthly-price-id
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_TEST=price_your-annual-price-id

# Legacy Test Keys (kept for reference - OPTIONAL)
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_your-legacy-publishable-key
STRIPE_SECRET_KEY_TEST=sk_test_your-legacy-secret-key

# Feature Flag
STRIPE_ENABLED=true

# ============================================
# EMAIL - GMAIL SMTP (DEVELOPMENT)
# ============================================
# For development and testing only
# Production uses Resend (see below)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ============================================
# EMAIL - RESEND (PRODUCTION)
# ============================================
# Production email service
# Setup: https://resend.com/
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=support@yourdomain.com
RESEND_ADMIN_EMAIL=support@yourdomain.com

# ============================================
# VIDEO HOSTING - BUNNY STREAM
# ============================================
# Setup: https://bunny.net/
# Library ID from Bunny Stream dashboard
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_API_KEY=your-bunny-api-key
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_PULL_ZONE=vz-xxxxxxxx-xxx

# ============================================
# AI INTEGRATION - ANTHROPIC
# ============================================
# Setup: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key

# ============================================
# LOGGING - AXIOM
# ============================================
# Setup: https://axiom.co/
# For production observability and monitoring
AXIOM_TOKEN=xaat-your-axiom-token
AXIOM_DATASET=becoming-diamond-prod
# AXIOM_ORG_ID=your-org-id  # Optional

# ============================================
# ADMIN & MISC
# ============================================
ADMIN_API_KEY=change-this-in-production
ADMIN_EMAIL=support@yourdomain.com
NEXT_PUBLIC_ADMIN_EMAIL=support@yourdomain.com

# Base URL for the application
# Development: http://localhost:3003
# Production: https://www.yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3003

# ============================================
# NOTES
# ============================================
# 1. Never commit .env.local or .env.prod to git
# 2. Always use different secrets for dev/prod environments
# 3. Rotate secrets regularly (at least quarterly)
# 4. Use Vercel environment variables for production deployments
# 5. Test Mode Stripe keys start with pk_test/sk_test
# 6. Live Mode Stripe keys start with pk_live/sk_live
# 7. Generate AUTH_SECRET with: openssl rand -base64 32

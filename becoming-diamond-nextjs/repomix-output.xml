  try {
    const session = await auth();

    if (!session?.user?.id) {
      await log.warn('Unauthorized profile access', {
        duration: Date.now() - startTime,
        timestamp: new Date().toISOString(),
      });
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });

    await log.info(`Welcome email queued for ${params.email}`, "EMAIL_SERVICE");

    return {
      success: true,
      emailId: "handled-by-nextauth", // FALSE - NextAuth doesn't send welcome emails
    };
  }
  // ...
}
```


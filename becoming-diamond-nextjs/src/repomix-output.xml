            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 48px 32px;
            text-align: center;
          }
          .logo {
            color: #4fc3f7;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 32px;
          }
          .icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 24px;
            background: ${colors[type].bg};
            border: 3px solid ${colors[type].border};
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
          }
          h1 {
            color: #ffffff;

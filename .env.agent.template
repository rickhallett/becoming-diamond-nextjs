# ============================================
# .env.agent TEMPLATE - Autonomous Deployment Credentials
# ============================================
# PURPOSE: Enable AI agent autonomous deployment with MCP browser automation
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.agent.template .env.agent
# 2. Fill in all values (search for <...> placeholders)
# 3. Secure the file: chmod 600 .env.agent
# 4. Verify .env.agent is in .gitignore
# 5. Consider encrypting with git-crypt or SOPS
#
# SECURITY WARNING:
# This file contains sensitive credentials. NEVER commit to git!
# Store backups in 1Password or similar password manager.
# ============================================

# ============================================
# BROWSER AUTOMATION CREDENTIALS
# ============================================
# These enable chrome-devtools-mcp to autonomously log into
# web consoles and perform configuration tasks

# Google Cloud Platform (for OAuth app creation)
GOOGLE_ACCOUNT_EMAIL=<support@becomingdiamond.com>
GOOGLE_ACCOUNT_PASSWORD=<your-secure-password>
GOOGLE_2FA_SECRET=<base32-totp-secret>  # Get during 2FA setup, e.g., JBSWY3DPEHPK3PXP
GOOGLE_CLOUD_PROJECT_ID=<becoming-diamond-prod>
GOOGLE_CLOUD_PROJECT_NUMBER=<123456789>

# Vercel (only if not using token below)
# Prefer VERCEL_TOKEN over password authentication
VERCEL_EMAIL=<support@becomingdiamond.com>
VERCEL_PASSWORD=<your-password>

# Domain Registrar - Cloudflare (recommended for API access)
CLOUDFLARE_EMAIL=<support@becomingdiamond.com>
CLOUDFLARE_API_KEY=<your-global-api-key>
CLOUDFLARE_ZONE_ID=<zone-id-for-becomingdiamond.com>

# Alternative: Other registrars (browser automation required)
DOMAIN_REGISTRAR=cloudflare  # Options: cloudflare, namecheap, godaddy
REGISTRAR_EMAIL=<email>
REGISTRAR_PASSWORD=<password>
REGISTRAR_API_KEY=<api-key-if-available>

# GitHub (only if not using token below)
GITHUB_EMAIL=<support@becomingdiamond.com>
GITHUB_PASSWORD=<your-password>
GITHUB_2FA_SECRET=<base32-totp-secret>

# ============================================
# CLI TOOL CREDENTIALS (Preferred Method)
# ============================================
# These enable autonomous CLI operations without browser automation
# More secure and reliable than password-based automation

# Vercel CLI Token (RECOMMENDED)
# Get with: vercel login && cat ~/.vercel/auth.json
# Or create in Vercel dashboard: Settings → Tokens
VERCEL_TOKEN=<your-vercel-token>
VERCEL_ORG_ID=<org-id>
VERCEL_PROJECT_ID=<project-id>

# GitHub Personal Access Token (RECOMMENDED)
# Get with: gh auth token
# Or create in GitHub: Settings → Developer settings → Personal access tokens
# Required scopes: repo, admin:org, admin:repo_hook
GITHUB_TOKEN=<ghp_your-github-token>

# Turso API Token
# Get with: turso auth token
# Or from Turso dashboard: Settings → Tokens
TURSO_API_TOKEN=<your-turso-token>
TURSO_ORG=<organization-name>

# Stripe API Keys
# Get from Stripe dashboard: Developers → API keys
STRIPE_API_KEY=<sk_test_or_sk_live>
STRIPE_PUBLISHABLE_KEY=<pk_test_or_pk_live>

# ============================================
# APPLICATION SECRETS - Production
# ============================================
# These will be set as environment variables in Vercel

# NextAuth Configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=<generate-unique-32-char-secret>
NEXTAUTH_URL_PRODUCTION=https://becomingdiamond.com
NEXTAUTH_URL_STAGING=https://staging.becomingdiamond.com
NEXTAUTH_URL_LOCALHOST=http://localhost:3003

# Database - Production
# Get from Turso dashboard after creating database
TURSO_DATABASE_URL_PROD=libsql://<database-name>.turso.io
TURSO_AUTH_TOKEN_PROD=<production-auth-token>

# Database - Staging
TURSO_DATABASE_URL_STAGING=libsql://<database-name>-staging.turso.io
TURSO_AUTH_TOKEN_STAGING=<staging-auth-token>

# OAuth Credentials - Production
# Will be populated by agent after creating OAuth apps
# Or fill in if already created
AUTH_GOOGLE_ID_PROD=<google-oauth-client-id>.apps.googleusercontent.com
AUTH_GOOGLE_SECRET_PROD=<google-oauth-client-secret>

# OAuth Credentials - Staging
AUTH_GOOGLE_ID_STAGING=<google-oauth-client-id>.apps.googleusercontent.com
AUTH_GOOGLE_SECRET_STAGING=<google-oauth-client-secret>

# Stripe - Production (Live Mode)
# Get from Stripe dashboard: Developers → API keys (Live mode)
STRIPE_SECRET_KEY_PROD=sk_live_<your-live-secret-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_PROD=pk_live_<your-live-publishable-key>

# Stripe - Staging/Test Mode
# Get from Stripe dashboard: Developers → API keys (Test mode)
STRIPE_SECRET_KEY_TEST=sk_test_<your-test-secret-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_<your-test-publishable-key>

# Bunny Stream (shared across all environments)
# Already configured in main .env - copying here for completeness
BUNNY_STREAM_LIBRARY_ID=512164
BUNNY_STREAM_API_KEY=<your-bunny-api-key>
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_PULL_ZONE=vz-xxxxxxx-xxx

# Email/SMTP Configuration
# For Gmail: Use App Password (not regular password)
# Get from: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@becomingdiamond.com
SMTP_PASS=<gmail-app-password>

# Axiom Logging
# Get from Axiom dashboard: Settings → API Tokens
AXIOM_TOKEN=<your-axiom-api-token>
AXIOM_DATASET_PROD=becoming-diamond-prod
AXIOM_DATASET_STAGING=becoming-diamond-staging
AXIOM_DATASET_DEV=becoming-diamond-dev

# Decap CMS OAuth
# GitHub OAuth app credentials for CMS authentication
GITHUB_CLIENT_ID=<decap-cms-oauth-client-id>
GITHUB_CLIENT_SECRET=<decap-cms-oauth-client-secret>

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
# These control agent behavior during deployment

# Deployment Strategy
DEPLOYMENT_ENVIRONMENT=development  # Options: development, staging, production
AUTO_DEPLOY_STAGING=true           # Auto-deploy when pushing to staging branch
AUTO_DEPLOY_PRODUCTION=false       # Require manual approval for production
REQUIRE_APPROVAL_FOR_PROD=true     # Pause for human approval before production
ROLLBACK_ENABLED=true              # Enable automatic rollback on failure

# Database Strategy
DATABASE_STRATEGY=separate  # Options: shared, separate
# shared = Use same database for staging/production (simpler, lower cost)
# separate = Dedicated databases (safer, better isolation)

# Testing Requirements
RUN_TESTS_BEFORE_DEPLOY=true      # Run full test suite before deployment
MIN_LIGHTHOUSE_SCORE=90            # Minimum performance score required
BLOCK_DEPLOY_ON_TEST_FAIL=true    # Prevent deployment if tests fail

# ============================================
# NOTIFICATION SETTINGS (Optional)
# ============================================
# Configure deployment notifications

# Slack Webhook (optional)
# Create in Slack: Workspace Settings → Integrations → Incoming Webhooks
SLACK_WEBHOOK_URL=<https://hooks.slack.com/services/...>
SLACK_CHANNEL=#deployments

# Email Notifications
DEPLOYMENT_NOTIFICATION_EMAIL=support@becomingdiamond.com

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=<discord-webhook-url>

# ============================================
# TESTING CREDENTIALS (Safe to Store)
# ============================================
# These are test/development credentials only

# Stripe Test Cards (publicly documented, safe)
STRIPE_TEST_CARD_NUMBER=4242424242424242
STRIPE_TEST_CARD_EXP=12/34
STRIPE_TEST_CARD_CVC=123

# Test User Accounts
TEST_USER_EMAIL=test@becomingdiamond.com
TEST_USER_PASSWORD=<test-password-for-automated-testing>

# ============================================
# HOW TO EXTRACT CREDENTIALS
# ============================================

# Google 2FA Secret:
# 1. Go to Google Account → Security → 2-Step Verification
# 2. Set up Authenticator app
# 3. Click "Can't scan QR code?"
# 4. Copy the 16-character base32 secret (e.g., JBSWY3DPEHPK3PXP)

# Vercel Token:
# Method 1 (CLI):
#   vercel login
#   cat ~/.vercel/auth.json
# Method 2 (Dashboard):
#   Vercel Dashboard → Settings → Tokens → Create Token

# GitHub Token:
# Method 1 (CLI):
#   gh auth login
#   gh auth token
# Method 2 (Dashboard):
#   GitHub → Settings → Developer settings → Personal access tokens → Generate new token
#   Required scopes: repo, admin:org, admin:repo_hook

# Cloudflare API Key:
# Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Or use Global API Key (legacy, less secure)

# Cloudflare Zone ID:
# Cloudflare Dashboard → Select domain → Overview → Zone ID (right sidebar)

# Turso Token:
# Method 1 (CLI):
#   turso auth token
# Method 2 (Dashboard):
#   Turso Dashboard → Settings → Tokens → Create Token

# ============================================
# SECURITY REMINDERS
# ============================================

# After filling out this file:
# 1. Rename to .env.agent: mv .env.agent.template .env.agent
# 2. Set permissions: chmod 600 .env.agent
# 3. Verify not tracked: git status (should not appear)
# 4. Optional: Encrypt with git-crypt or SOPS
# 5. Store backup in password manager
# 6. Never share in Slack/email/screenshots
# 7. Rotate credentials every 30-90 days
# 8. Use service accounts instead of personal accounts where possible

# To encrypt with SOPS:
#   sops -e .env.agent > .env.agent.encrypted
#   git add .env.agent.encrypted

# To decrypt:
#   sops -d .env.agent.encrypted > .env.agent

# ============================================
# END OF TEMPLATE
# ============================================
